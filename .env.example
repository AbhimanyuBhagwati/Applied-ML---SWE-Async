# Get a trial key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Optional
# COHERE_MODEL=command-a-plus-05-2026
# MAX_OUTPUT_TOKENS=4096
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=1
# MAX_TOOL_ROUNDS=4

# Wikipedia tool.
# Worth setting. Wikimedia's User-Agent policy asks for a way to reach a
# human, and they may block clients that don't provide one. Leave it
# commented out rather than blank: an empty value overrides the default
# and the app refuses to start.
# WIKIPEDIA_USER_AGENT=yourapp/1.0 (you@example.com)

# MAX_TOOL_CALLS_PER_ROUND=4
# WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
# WIKIPEDIA_ARTICLE_URL=https://en.wikipedia.org/wiki/

# Budget for one /chat request as a whole.
# MAX_TOTAL_SEARCHES=8
# TOOL_LOOP_SECONDS=45

# WIKIPEDIA_MAX_RESULTS=5
# WIKIPEDIA_EXTRACT_CHARS=1200
# WIKIPEDIA_TIMEOUT_SECONDS=10
