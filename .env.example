# Get a trial key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Optional
# COHERE_MODEL=command-a-plus-05-2026
# MAX_OUTPUT_TOKENS=4096
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=1

# Off when unset/zero. Set either one to turn it on.
# API_AUTH_TOKEN=
# RATE_LIMIT_PER_MINUTE=0

# Set only when a proxy in front sets this header, never otherwise.
# CLIENT_IP_HEADER=X-Forwarded-For
